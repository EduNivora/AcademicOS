# Never commit the real .env file.
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
DATABASE_URL=postgresql://postgres:password@localhost:5432/edunivora_ai
DATABASE_SSL=false

# Google OAuth Web client ID. The Flutter client must request an ID token
# for this exact audience. Never trust a user ID supplied by the app.
GOOGLE_OAUTH_CLIENT_ID=replace-with-web-client-id

# Provider secret is server-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_OUTPUT_TOKENS=1800

# Optional absolute path; default is prompts/academic-system.md
SYSTEM_PROMPT_FILE=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8787
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=1 minute
MAX_USER_MESSAGE_CHARS=12000
MAX_CONTEXT_MESSAGES=20